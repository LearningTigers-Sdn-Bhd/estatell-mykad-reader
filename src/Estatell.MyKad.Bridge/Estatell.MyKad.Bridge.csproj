<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- No console window at login on Windows. -->
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win'))">WinExe</OutputType>
    <AssemblyName>mykad-reader</AssemblyName>
    <!-- Windows shows the title as the file description, for example in Task Manager. -->
    <AssemblyTitle>Estatell MyKad Reader</AssemblyTitle>
    <ApplicationIcon>Tray\Icons\app.ico</ApplicationIcon>
    <RootNamespace>Estatell.MyKad.Bridge</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The macOS tray passes function pointers to the Objective-C runtime. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- PCSC is not marked trimmable, so its warnings fold into one IL2104. The only one is IL2075 in
         SCardHelper.GetAttrDesc, which is safe (see docs/01-card/02-pcsc.md). Our projects still warn in full.
         Check a new package with -p:TrimmerSingleWarn=false. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Estatell.MyKad.Bridge.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Tray\Icons\menubar.png" LogicalName="menubar.png" />
    <EmbeddedResource Include="Tray\Icons\tray-ready.ico" LogicalName="tray-ready.ico" />
    <EmbeddedResource Include="Tray\Icons\tray-grey.ico" LogicalName="tray-grey.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Estatell.MyKad\Estatell.MyKad.csproj" />
  </ItemGroup>
</Project>
